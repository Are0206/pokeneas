<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Pokenea Filosófico</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
      background-color: #f4f4f9;
      margin: 0;
    }
    .card {
      background: white;
      padding: 2rem;
      border-radius: 12px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
      text-align: center;
      max-width: 400px;
    }
    img {
      max-width: 100%;
      height: auto;
      border-radius: 8px;
    }
    blockquote {
      font-style: italic;
      color: #555;
      margin: 1.5rem 0;
    }
    footer {
      font-size: 0.8rem;
      color: #888;
    }
  </style>
</head>
<body>
  <div class="card">
    <img src="<%= pokenea.imagen %>" alt="<%= pokenea.nombre %>">
    <blockquote>"<%= pokenea.fraseFilosofica %>"</blockquote>
    <footer>Contenedor ID: <strong><%= containerId %></strong></footer>
  </div>
</body>
</html>